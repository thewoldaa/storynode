# ---------------------------------------------------------------------------
# Line endings.
#
# The repository is built on Windows and read from Linux CI. Normalise
# everything to LF in the object store and let each platform check out what it
# needs, so a shell script authored on Windows still runs on the runner.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# Windows-only sources and project files stay CRLF on checkout.
*.sln  text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.rc   text eol=crlf

# PowerShell scripts must keep CRLF out of the way; pwsh handles LF fine but
# Windows PowerShell 5.1 is happier with CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# ---------------------------------------------------------------------------
# Binary assets. Git must not attempt to diff or merge these.
# ---------------------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.nupkg binary
*.dll  binary
*.lib  binary
*.exe  binary
*.pdb  binary

# ---------------------------------------------------------------------------
# Generated files. Collapse these in diffs and in GitHub's language stats.
# ---------------------------------------------------------------------------
package-lock.json linguist-generated=true
CHANGELOG.md      linguist-generated=true
