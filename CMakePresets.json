{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug (Visual Studio 2022)",
      "description": "Everyday development build. Debug information, no optimisation, tests on.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STORYNODE_BUILD_TESTS": "ON",
        "STORYNODE_BUILD_APP": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Visual Studio 2022)",
      "description": "Optimised build for shipping. Tests off, because a release build is not where they belong.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STORYNODE_BUILD_TESTS": "OFF",
        "STORYNODE_BUILD_APP": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Visual Studio 2022)",
      "description": "The build CI runs. Fixed binary directory so the workflow can find the test log.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STORYNODE_BUILD_TESTS": "ON",
        "STORYNODE_BUILD_APP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
