#include "resource.h"
#include <winver.h>

// The interface assets are NOT declared here.
//
// They are globbed by cmake/GenerateUiResources.cmake, which writes one
// RCDATA entry per file into a generated script that is compiled alongside
// this one. Listing them by hand would be a shared file every task must edit,
// which is exactly the conflict the interface split exists to prevent.
//
// So this file holds only the two things that are not part of the split and
// that a task never touches: the icon and the version information.

IDI_APPICON ICON "app.ico"

// Version details. Worth filling in properly: an unsigned binary with blank
// publisher fields is the shape SmartScreen and antivirus heuristics treat
// with the most suspicion, and this costs nothing.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "StoryNode"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "storynode"
            VALUE "OriginalFilename","storynode.exe"
            VALUE "ProductName",     "StoryNode"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
